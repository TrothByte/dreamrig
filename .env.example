# Источник данных приложения: mock (MSW) или supabase
VITE_API_MODE=mock

# Живой источник данных (используется только при VITE_API_MODE=supabase)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Для seed-скрипта scripts/seed-supabase.ts (service role ключ не попадает в клиент)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
